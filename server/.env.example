# Copy this file to server/.env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civicfix
# Set to true for hosted databases that require SSL (Neon, Render, Supabase...)
DATABASE_SSL=false
# Used only by `npm test`; the name MUST end in _test (it is wiped on every run)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/civicfix_test

# Long random string used to sign login tokens (min 32 chars in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Origin of the Vite dev server (only matters when frontend and API run on different origins)
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the app. 0 locally; 1 on Render/Railway/Heroku-style hosts.
TRUST_PROXY=0

# Photo storage: "local" (server/uploads), "database" (inside PostgreSQL; used on Render)
# or "cloudinary"
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Only when STORAGE_DRIVER=cloudinary — copy "API environment variable" from the Cloudinary dashboard
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Admin account created by `npm run db:seed`. Required in production (demo password is refused).
SEED_ADMIN_NAME=CivicFix Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set true to also load demo citizens + sample complaints in production (for a college demo)
SEED_DEMO=false

# Optional rate-limit overrides (leave unset in production). Automated browser tests
# log in many times from one IP, so they raise the login limit.
# RATE_LIMIT_AUTH=20
# RATE_LIMIT_GLOBAL=600
# RATE_LIMIT_REPORTS=10
